        ]
      }
    ],
    "Pathfinder": [
      {
        "patch": "February 04, 2020 Patch",
        "details": []
      },
      {
        "patch": "April 07, 2020 Patch",
        "details": [
          "[Perks] Adjust -> Grappling Hook: Increased cooldown from 13 seconds to 15 seconds.",
          "[Perks] Fix -> Low Profile: Leg shots now deal as much damage as body shots."
        ]
      }
    ],
    "Revenant": [
      {
        "patch": "February 04, 2020 Patch",
        "details": []
      },
      {
        "patch": "March 03, 2020 Patch",
        "details": [
          "[Perks] Fix -> Silence: Fixed getting assist credit when placing the ability on a player who is downed."
        ]
      },
      {
        "patch": "April 07, 2020 Patch",
        "details": [
          "[Tactical] Buff -> Silence: Increased duration of status effect from 10 seconds to 20 seconds.",
          "[Tactical] Buff -> Silence: Now disables Gibraltar’s Gun Shield.",
          "[Tactical] Buff -> Silence: Increased the duration of area of effect from 5 seconds to 10 seconds.",
          "[Tactical] Buff -> Silence: Now has 2 charges.",
          "[Tactical] Fix -> Silence: Fixed bug where sometimes players would lose aim assist after being hit with the ability.",
          "[Ultimate] Fix -> Death Totem: Characters are now respawned with 50 health (or whatever health they had when they activated it, if lower) instead of 1.",
          "[Ultimate] Fix -> Death Totem: Fixed bug for cases when Revenant places the totem on the train, a player is respawned to it while on the train, and the train is moving, the player could be respawned somewhere else on the map or even off the map.",
          "[Ultimate] Fix -> Death Totem: Fixed bug for cases where players that were under Revenant’s Death Protection could still be healed by Lifeline’s D.O.C. Heal Drone and Wattson’s Interception Pylon.",
          "[Passive] Nerf -> Removed Low Profile."
        ]
      }
    ],
    "Wattson": [
      {
