      },
      {
        "patch": "March 03, 2020 Patch",
        "details": [
          "[Perks] Adjust -> Tracker: Added a new clue: Weapon Reloaded"
        ]
      }
    ],
    "Crypto": [
      {
        "patch": "February 04, 2020 Patch",
        "details": [
          "[Perks] Fix -> Surveillance Drone: Dome of Protection no longer can stick to drone."
        ]
      },
      {
        "patch": "March 03, 2020 Patch",
        "details": [
          "[Perks] Adjust -> Surveillance Drone: Primary weapons will now automatically reload while in drone view.",
          "[Perks] Fix -> Fixed players getting assist credit when using the drone on a player who is downed.",
          "[Perks] Fix -> Fixed a bug where players could place Gibraltar's Dome of Protection on the drone allowing the Dome to be mobile while in use."
        ]
      },
      {
        "patch": "April 07, 2020 Patch",
        "details": [
          "[Perks] Fix -> Surveillance Drone: Fix for cases where players would not receive assist credit when using the drone to scan enemies."
        ]
      }
    ],
    "Gibraltar": [
      {
        "patch": "March 03, 2020 Patch",
        "details": [
          "[Base] Nerf -> Gun Shield: Health reduced from 75 to 50.",
          "[Perks] Fix -> Dome of Protection: Fixed an issue with the player being able to place the dome on Crypto’s drone, allowing the dome to be mobile while in use."
        ]
      },
      {
        "patch": "April 07, 2020 Patch",
        "details": [
          "[Base] Nerf -> Gun Shield: Now disabled if silenced by Revenant."
        ]
      }
    ],
    "Lifeline": [
      {
        "patch": "February 04, 2020 Patch",
        "details": []
      },
      {
        "patch": "April 07, 2020 Patch",
        "details": [
          "[Perks] Buff -> Combat Medic: Lifeline can now access secret compartments with more loot on Blue Supply Bins.",
          "[Perks] Buff -> Combat Medic: The secondary compartment will always contain some mixture of health items, weapon attachments, and Knockdown Shields.",
          "[Perks] Fix -> Low Profile: Leg shots now deal as much damage as body shots."
        ]
      }
    ],
    "Mirage": [
      {
        "patch": "April 07, 2020 Patch",
        "details": []
      },
