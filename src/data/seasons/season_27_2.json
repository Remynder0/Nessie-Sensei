  "patches": {
    "Octane": [
      {
        "patch": "Winter Wipeout Event",
        "details": [
          "[Passive] Buff -> Swift Mend now heals more the less HP you have.",
          "[Tactical - Stim Surge] Adjust -> Added a new ability for Octane **Stim Surge**: If Octane uses his tactical again, while stim is already active, he uses a new mixture which grants him Fortified, triggers Swift Mend, and allows Swift Mend to continue healing through damage.",
          "[Tactical - Stim] Buff -> While stimmed, Octane can sprint and use consumables. Reduce the time before Octane can reuse his Stim from 1.8s to 0.7s. Stim speed increased by 5%",
          "[Ultimate] Buff -> JumpPad now has two charges. JumpPad has improved handling when double jumping.",
          "[Perks] Adjust -> Four new upgrades to replace all the base upgrades: Thick Skin, Squad Rush, Daredevil, Triple Jump"
        ]
      }
    ],
    "Newcastle": [
      {
        "patch": "Winter Wipeout Event",
        "details": [
          "[Passive] Buff -> Incorporate Heroes Hustle into base kit. Movement speed penalty reduced from 25% to 75%",
          "[Tactical] Buff -> Incorporate Swift Shield into base kit. Movement speed increased from 160 to 250.",
          "[Perks] Adjust -> Two new upgrades to replace Swift Shield and Heroes Hustle: Stronghold, Ready To Rumble, Defensive Line"
        ]
      }
    ],
    "Crypto": [
      {
        "patch": "Winter Wipeout Event",
        "details": [
          "[Passive] Buff -> Crypto gains long range Threat Vision while piloting his drone. Satellite Imagery incorporated into base kit.",
          "[Tactical] Adjust -> Reduced time to launch drone from 1.3 to 0.7s. Reduced time to reenter drone from 0.4 to 0.2s. Reduced animation frame that Crypto reenters drone from 7 to 2.",
          "[Perks] Adjust -> Two new upgrades to replace Off the Grid and Satellite Imagery: Ally.MoveTo(), Power Coupling"
        ]
      }
    ],
    "Revenant": [
      {
        "patch": "Winter Wipeout Event",
