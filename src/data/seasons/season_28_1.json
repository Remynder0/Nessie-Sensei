    "patches": {
        "Ballistic": [],
        "Bloodhound": [
            {
                "patch": "Breach Patch Notes (2026-02-09)",
                "details": [
                    "[Passive] Buff -> Enemies outside of 13m no longer block white ravens from spawning (Flock upgrade brought into base kit)",
                    "[Passive] Buff -> Clues more than 13m away no longer block White ravens (was ~50m)",
                    "[Tactical] Buff -> Total scan duration up to 4s (was 3s), full-body duration remains half the full scan duration (so now 2s, was 1.5s)",
                    "[Tactical] Adjust -> Enhanced scan visibility",
                    "[Ultimate] Buff -> Cooldown reduced to 2.5 minutes (was 4 minutes)",
                    "[Ultimate] Buff -> Activation time reduced by ~20%",
                    "[Ultimate] Adjust -> After activation, the wider FOV gradually shifts back to your normal FOV",
                    "[Ultimate] Buff -> Knocks while your ultimate is active increase the duration by 5s (will always reset to 10s if below)",
                    "[Perks] New -> Taste of Blood: Regen 50 health when getting a knock while your ultimate is active",
                    "[Perks] New -> Raven’s Flight: When activating your white ravens, they can ping enemies twice as far as normal",
                    "[Perks] New -> Hunter’s Agility: Your tactical is faster to use and has -5s cooldown",
                    "[Perks] Removed -> Raven’s Blessing, Flock, and Sighthound"
                ]
            }
        ],
        "Catalyst": [
            {
                "patch": "Breach Patch Notes (2026-02-09)",
                "details": [
                    "[Passive] Buff -> Can now reinforce up to 4 doors (was 2)",
                    "[Tactical] Buff -> Increased size by roughly 50%",
                    "[Tactical] Buff -> Reduced the delay before spikes can deal damage (was 2s, now 1s)",
                    "[Tactical] Buff -> Can now have 3 traps maximum (was 2)",
                    "[Tactical] Adjust -> Activation radius reduced by 20% (how close you have to be before the spikes stand up and the core is vulnerable)",
                    "[Ultimate] Buff -> You can now toggle to deploy the ultimate horizontally",
                    "[Ultimate] Buff -> Length increased by 5m",
                    "[Ultimate] Buff -> The wall can now build up through standard doors, Lifeline’s D.O.C. Halo, and Gibraltar’s Dome of Protection.",
                    "[Ultimate] Nerf -> Reduced Dark Veil duration when enemies walk through (was 7s, now 5s)",
                    "[Perks] New -> Hidden Spikes: The spike pool is now hidden to enemies while inactive",
                    "[Perks] New -> Sole Piercer: Spike traps activate 50% faster and deal 5 more damage per hit",
                    "[Perks] Removed -> Sister Spikes and Long Veil"
                ]
            }
        ],
        "Crypto": [
            {
                "patch": "Breach Patch Notes (2026-02-09)",
                "details": [
                    "[Tactical] Nerf -> Prevent Power Coupling for 5s after EMP",
                    "[Tactical] Nerf -> Reduced charge gained from scanning players from 10 to 5"
                ]
            }
        ],
        "Fuse": [
            {
                "patch": "Breach Patch Notes (2026-02-09)",
                "details": [
                    "[Passive] Buff -> Fuse is no longer slowed when taking explosive damage",
                    "[Tactical] Buff -> Faster weapon stow time when switching to the tactical",
                    "[Tactical] Buff -> Reduced delay before explosions start up (was 1.7s, now 1.0s)",
                    "[Tactical] Buff -> Increased base damage (was 10, now 15)",
                    "[Tactical] Adjust -> Reduced the duration by 50%",
                    "[Ultimate] Reworked -> Refreshed ultimate behavior. Fires a mortar that explodes against the ground, then sprays out smaller bombs around its landing point. When aiming down sights, the mortar can pierce cover up to 13m deep and deliver explosives to the other side.",
                    "[Perks] New -> Pyro Techniques: Your ultimate will drop behind patches of fire for 8 seconds after the bombs explode",
                    "[Perks] New -> Knuckle Jumper: Jumping when next to your own Knuckle Clusters will give you an explosive boost (destroys the cluster afterwards).",
                    "[Perks] New -> Reignition: Dealing explosive damage to enemies recharges your ultimate (for every 2 damage dealt, reduces cooldown by 1 second)",
                    "[Perks] Removed -> Ring Master, Scar Tissue, and Knuckle Hustler"
                ]
            }
        ],
        "Octane": [
