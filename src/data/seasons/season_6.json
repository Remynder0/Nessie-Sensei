    "patches": {
        "Crypto": [
            {
                "patch": "August 18, 2020 Patch",
                "details": [
                    "[Class] New -> Recon Passive Perk: Crypto can now use Survey Beacons.",
                    "[Tactical] Adjust -> Surveillance Drone: Can now open loot vaults if Crypto has a Vault Key in his inventory. It consumes the key as usual.",
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with the drone not detecting Wattson's Perimeter Security fences.",
                    "[Tactical] Fix -> Surveillance Drone: Fixed an audio issue with Survey Beacons sometimes making very little sound when using it in the drone view.",
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with his drone not taking damage from directly below.",
                    "[Ultimate] Adjust -> Drone EMP: Now slows teammates.",
                    "[Ultimate] Fix -> Drone EMP: Fixed an issue with EMP not destroying Loba’s Black Market Boutique."
                ]
            },
            {
                "patch": "September 03, 2020 Patch",
                "details": [
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with the drone not detecting players while on a Emplaced Minigun \"Sheila\".",
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue where while the drone is in Caustic gas the whole server would hear the drone audio."
                ]
            },
            {
                "patch": "October 06, 2020 Patch",
                "details": [
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with Crypto being able to use his drone while using Loba’s Black Market Boutique.",
                    "[Ultimate] Fix -> Drone EMP: Fixed an issue with VFX shows false positive when hitting Crypto’s Drone."
                ]
            }
        ],
        "Loba": [
            {
                "patch": "August 18, 2020 Patch",
                "details": [
                    "[Passive] Adjust -> Eye for Quality and Black Market Boutique: Increased range from 3100 units to 4500 units (77.5m to 112.5m).",
                    "[Ultimate] Adjust -> Black Market Boutique: Is now 50% charged at the start of every match.",
                    "[Tactical] Fix -> Burglar's Best Friend: Fixed inconsistencies with teleporting onto a supply ship.",
                    "[Tactical] Fix -> Burglar's Best Friend: Fixed an issue allowing teleporting into drills around Lava Fissure.",
                    "[Tactical] Fix -> Burglar's Best Friend: Fixed an issue preventing teleporting on certain terrain in Staging."
                ]
            },
            {
                "patch": "September 03, 2020 Patch",
                "details": [
                    "[Tactical] Fix -> Burglar's Best Friend: Fixed an issue causing the teleport to fail in certain areas."
                ]
            },
            {
                "patch": "October 06, 2020 Patch",
                "details": [
                    "[Passive] Adjust -> Eye for Quality and Black Market Boutique: Increased range from 3100 units to 4500 units (77.5m to 112.5m).",
                    "[Ultimate] Adjust -> Black Market Boutique: Is now 50% charged at the start of every match.",
                    "[Tactical] Fix -> Burglar's Best Friend: Fixed an issue with enemies getting teleported with Loba when they melee her when she teleports."
                ]
            }
        ],
        "Octane": [
            {
                "patch": "August 18, 2020 Patch",
                "details": [
                    "[Tactical] Adjust -> Stim: Now able to use while healing, but not removing the incurred slowness."
                ]
            },
            {
                "patch": "October 06, 2020 Patch",
                "details": [
                    "[Perks] Fix -> No longer able to drop Holo-Sprays while using Stim."
                ]
            }
        ],
        "Rampart": [
            {
                "patch": "August 18, 2020 Patch",
                "details": [
                    "Introduced -> Legend released this season."
                ]
            },
            {
                "patch": "September 03, 2020 Patch",
                "details": [
                    "[Tactical] Fix -> Amped Cover: Fixed Amped Cover from floating in the air when placed on a supply ship.",
                    "[Tactical] Fix -> Amped Cover: Fixed an issue with the Longbow DMR, Triple Take, Mastiff Shotgun, and Sentinel not always receiving the Amped Cover buff.",
                    "[Tactical] Fix -> Amped Cover: Fixed an issue with Amped Cover being able to be placed at bad angles around the map.",
                    "[Tactical] Fix -> Amped Cover: Fixed an issue with the Amped Cover not being destroyed by the initial blast of Charge Rifle.",
                    "[Tactical] Fix -> Amped Cover: Fixed an issue with bullets getting amped before they cross the amped wall from certain angles."
                ]
            },
            {
                "patch": "October 06, 2020 Patch",
                "details": [
                    "[Ultimate] Buff -> Emplaced Minigun \"Sheila\": Increased the rate at which the bullet spread tightens.",
                    "[Ultimate] Fix -> Emplaced Minigun \"Sheila\": Fixed an issue with being able to place Sheila on loot bins.",
                    "[Ultimate] Fix -> Emplaced Minigun \"Sheila\": Fixed an issue with doors closing when dismounting a placed Sheila in a doorway."
                ]
            },
            {
                "patch": "August 20, 2020 Patch",
                "details": [
                    "[Tactical] Fix -> Amped Cover: Fixed client error with it in softened gore locales.",
                    "[Tactical] Fix -> Amped Cover: Fixed a server error causing immediate disconnects when Rampart puts down a wall."
                ]
            }
        ],
        "Revenant": [
