                ]
            },
            {
                "patch": "January 07, 2021 Patch",
                "details": [
                    "[Ultimate] Fix -> Launch Pad: Fixed an issue with it preventing players from jumping."
                ]
            }
        ],
        "Rampart": [
            {
                "patch": "November 04, 2020 Patch",
                "details": [
                    "[Tactical] Buff -> Amped Cover: Build time decreased from 4 seconds to 3 seconds.",
                    "[Tactical] Fix -> Amped Cover: Fixed an issue with Rampart not being able to place a wall while jumping.",
                    "[Ultimate] Buff -> Emplaced Minigun \"Sheila\": Spin-up time decreased from 2 seconds to 1.25 seconds.",
                    "[Ultimate] Fix -> Emplaced Minigun \"Sheila\": Fixed an issue with Sheila teleporting when placed on a hatch in World's Edge Staging."
                ]
            },
            {
                "patch": "January 05, 2021 Patch",
                "details": [
                    "[Tactical] Nerf -> Amped Cover: Decreased cooldown from 30 seconds to 20 seconds.",
                    "[Ultimate] Fix -> Emplaced Minigun \"Sheila\": Fixed an issue that allowed Rampart to place Sheila while in the Phase Runner.",
                    "[Ultimate] Fix -> Emplaced Minigun \"Sheila\": Fix an issue where UI elements stayed on screen after using Sheila."
                ]
            },
            {
                "patch": "December 09, 2020 Patch",
                "details": [
                    "[Tactical] Fix -> Amped Cover: Fixed an issue with the walls at the feet of the players on the train killing them."
                ]
            },
            {
                "patch": "December 01, 2020 Patch",
                "details": [
                    "[Ultimate] Fix -> Emplaced Minigun \"Sheila\": Fixed an issue with the turret on a Trident causing crashes. This ability is now re-enabled for use on the vehicle."
                ]
            },
            {
                "patch": "November 18, 2020 Patch",
                "details": [
                    "[Ultimate] Fix -> Emplaced Minigun \"Sheila\": Fixed an issue with being able to put the turret on Crypto’s Surveillance Drone.",
