                ]
            },
            {
                "patch": "November 04, 2020 Patch",
                "details": [
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with the drone being able to drop items from Crypto’s inventory.",
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with the drone not being able to fit through certain windows.",
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with the drone marking friendly Mirage decoys as enemies."
                ]
            },
            {
                "patch": "January 05, 2021 Patch",
                "details": [
                    "[Tactical] Fix -> Surveillance Drone: Fixed an issue with being able to put Rampart’s Emplaced Minigun \"Sheila\" on the drone."
                ]
            }
        ],
        "Horizon": [
            {
                "patch": "November 04, 2020 Patch",
                "details": [
