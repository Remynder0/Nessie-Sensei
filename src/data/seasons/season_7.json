                ]
            },
            {
                "patch": "January 05, 2021 Patch",
                "details": [
                    "[Ultimate] Fix -> Black Market Boutique: Ammo taken no longer has a maximum limit nor takes up space towards the two items allowed to be taken."
                ]
            }
        ],
        "Octane": [
            {
                "patch": "November 04, 2020 Patch",
                "details": [
