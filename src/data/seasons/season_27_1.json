    "patches": {
        "Valkyrie": [
            {
                "patch": "Amped Patch Notes (2025-11-03)",
                "details": [
                    "[Passive] Buff -> Jetpack cooldown and fly speed reworked.",
                    "[Tactical] Buff -> Missile Swarm: removed self damage and stun effect, added short full body scan on hit, tac damage now puts movement passives on cooldown, removed 5 seconds of cooldown, removed vertical clearance firing restriction, improved missile pathing to work better in some situations such as low clearance situations (firing indoors or at targets under a bridge), increased max range.",
                    "[Ultimate] Buff -> Skyward Dive: increased launch height 15% (integrated Afterburners upgrade), reduced cooldown by 30 seconds, reduced delay before takeoff, slightly reduced time slowly rising before takeoff, removed self cancel cooldown penalty, reduced damage cooldown penalty.",
                    "[Perks] Adjust -> Upgrades: Level 2 - Afterburners: Removed (included by default), Eyes in the Sky: Moved to Level 2, Full Coverage: Changes missile swarm pattern to 4x5 (was 3x5); Level 3 - Supersonic: Ultimate launch time reduced ~50%, Aerial Expert: Improves jetpack horizontal speed, significantly improves handling, decreases initial fuel consumption, slightly reduces total fuel."
                ]
            }
        ],
        "Rampart": [
            {
                "patch": "Amped Patch Notes (2025-11-03)",
                "details": [
                    "[Passive] Buff -> Battle Modder: adds additional effect to old passive (Modded Loader). Cover walls permanently gain health as Rampart gains Evo Levels.",
                    "[Tactical] Buff -> Amped Cover: adds amped shield roof to wall, walls can now be charged by doing damage through the amped shield or by having the wall be damaged by enemies. Wall charge is converted to a speed boost by going over the wall - Wall can store up to 300 damage, which results in a 15 second speed boost at full charge. Speed boost time scales linearly with stored charge.",
                    "[Perks] Adjust -> Upgrades: Level 2 - Combat reserve: Bigger ammo stacks, extra grenades slots, access red weapon supply bins, Locked and Loaded: gain faster reloads and infinite ammo when behind amped cover and shield is in tact; Level 3 - Rebuild Module. Amped cover will regen health and rebuild shield section after not being damaged for a period of time."
                ]
            }
        ],
        "Horizon": [
            {
                "patch": "Amped Patch Notes (2025-11-03)",
                "details": [
                    "[Passive] Buff -> Gravity Lift: increased lift speed, increased hover time at top of lift, cooldown reductions.",
                    "[Ultimate] Buff -> Black Hole: reduced cooldown by 30 seconds, increased health.",
                    "[Perks] Adjust -> Upgrades: Level 2 - Gravity Boots: Press crouch while in the air to fall much more quickly, Newt Scoot: Press jump after exiting gravity lift to glide; Level 3 - Knock Expert: gain tactical charge on knocks."
                ]
            }
        ],
        "Revenant": [
            {
                "patch": "Amped Patch Notes (2025-11-03)",
                "details": [
                    "[Passive] Nerf -> Reduced the maximum possible velocity of Revenants Shadow Pounce"
                ]
            }
        ]
    }
