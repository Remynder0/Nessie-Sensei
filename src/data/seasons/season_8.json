    "patches": {
        "Crypto": [
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[Tactical] Adjust -> Surveillance Drone: Reloading the Mastiff Shotgun and 30-30 Repeater will no longer be faster while in Crypto’s drone.",
                    "[Tactical] Fix -> Surveillance Drone: Removed the ability to stick Arc Stars to friendly drones."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Tactical] Adjust -> Surveillance Drone: Crypto’s animation to bring out his drone is no longer skippable by throwing a Holo-Spray."
                ]
            }
        ],
        "Fuse": [
            {
                "patch": "February 04, 2021 Patch",
                "details": [
                    "[Tactical] Fix -> Knuckle Cluster: Fixed an issue that allowed it to do damage through shields."
                ]
            },
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "Introduced -> Fuse released this season."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Passive] Adjust -> Grenadier: Players can no longer double their grenades after looting a dead Fuse’s Death Box.",
                    "[Ultimate] Adjust -> The Motherlode now damages and destroys Launch Pads. When under a small enclosure, players will no longer be pushed out after using it."
                ]
            }
        ],
        "Horizon": [
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[Tactical] Adjust -> Gravity Lift: Horizon's abilities no longer get destroyed by Wattson’s Interception Pylon.",
                    "[Ultimate] Nerf -> Black Hole: Increased cooldown from 2 minutes to 3 minutes."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Tactical] Fix -> Gravity Lift: Fixed the Gravity Lift falling through the floor when used on the train tracks in Sorting Factory on World's Edge.",
                    "[Tactical] Adjust -> Gravity Lift: Using a zipline after a Gravity Lift will no longer increase accuracy."
                ]
            }
        ],
        "Loba": [
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[Passive] Adjust -> Eye for Quality: Loot inside unopened Care Packages is now visible with Eye for Quality and accessible through the Black Market Boutique.",
                    "[Tactical] Fix -> Burglar's Best Friend: Fixed a few exploitable areas on Kings Canyon that Loba was able to reach via her Bracelet."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Tactical] Fix -> Burglar's Best Friend: Fixed a few areas Loba could teleport into that would get her stuck."
                ]
            }
        ],
        "Octane": [
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[Ultimate] Adjust -> Hitting the jump pad from a standing position will launch players along a high arc (the speed and trajectory of the old super-jump). From a crouched position, players will launch along a low arc, meaning they'll fly lower but farther in the horizontal direction."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Passive] Adjust -> Swift Mend: Now disabled if silenced by Revenant.",
                    "[Ultimate] Adjust -> Launch Pad: Repeatedly using the same jump pad no longer disables double-jumps. Players can no longer “glide” along a wall after using it."
                ]
            }
        ],
        "Rampart": [
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[Tactical] Buff -> Amped Cover: Increased HP while building from 1 to 45 (sniper rounds still pierce through).",
                    "[Ultimate] Buff -> Mobile Minigun \"Sheila\": Increased angle from 120° to 180°. Can no longer be placed on Launch Pads in Octane's Gauntlet."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Tactical] Buff -> Amped Cover: Explosives damage Amped Cover normally, instead of inflicting 200 damage.",
                    "[Ultimate] Fix -> Mobile Minigun \"Sheila\": Can no longer be used to get under the world when placed too close to the Phase Runner in Olympus."
                ]
            }
        ],
        "Revenant": [
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Tactical] Adjust -> Silence now disables Mirage’s cloaked revive/respawn as well as Octane’s Swift Mend."
                ]
            }
        ],
        "Wattson": [
            {
                "patch": "March 15, 2021 Patch",
                "details": [
                    "Fix -> Wattson: Fixed an issue with her Electric Blue skin appearing without texture on console. Players who bought the skin before the fix will be refunded their Crafting Metals or Apex Coins, depending on which method they used."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Passive] Buff -> Spark of Genius: Wattson now passively regenerates shield at a rate of 0.5hp/s. Stacks with Interception Pylon regen rate."
                ]
            }
        ]
    }
}