        "Bangalore": [
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[Heirloom] Fix -> Fixed an issue with her Cold Steel heirloom not making sound effects when performing attacks."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Undocumented] Reduce particles from smoke -> Reduced the amount of particles from the smoke, effectively providing less cover from the outside (confirmed to be unintentional)."
                ]
            }
        ],
        "Bloodhound": [
            {
                "patch": "February 10, 2021 Patch",
                "details": [
                    "[Eye of the Allfather] Fix -> Fixed an issue with players not being scanned if already scanned by a different Bloodhound."
                ]
            },
            {
                "patch": "February 22, 2021 Patch",
                "details": [
                    "[Hunter's Moon skin] Fix -> Fixed an issue with the Hunter's Moon skin having untextured hands on consoles."
                ]
            }
        ],
        "Caustic": [
            {
                "patch": "February 04, 2021 Patch",
                "details": [
                    "[Nox Gas Grenade] Fix -> Fixed an edge case where the gas would persist even after his squad was eliminated."
                ]
            },
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[All gas] Buff -> All gas now dissipates as soon as Caustic's team is wiped.",
                    "[Nox Vision] Fix -> Sonar abilities no longer stop Caustic's highlight vision."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Nox Gas Grenade] Nerf -> Increased cooldown from 2.5 minutes to 3.5 minutes.",
                    "[Gas damage] Nerf -> Gas damage is now a flat 5 rather than 6-12.",
                    "[Fix] -> Fixed a bug that was causing the gas to flicker for some players affected by it.",
                    "[Undocumented] Reduce particles from gas -> Reduced the amount of particles from the gas, effectively providing less cover from the outside."
                ]
            }
        ],
        "Crypto": [
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[Surveillance Drone] Fix -> Removed the ability to stick Arc Stars to friendly drones."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Surveillance Drone] Buff -> Crypto’s animation to bring out his drone is no longer skippable by throwing a Holo-Spray.",
                    "[Reloading Mastiff Shotgun and 30-30 Repeater] Fix -> Reloading the Mastiff Shotgun and 30-30 Repeater will no longer be faster while in Crypto’s drone.",
                    "[Teleport to Replicator] Nerf -> Crypto can no longer teleport to a Replicator."
                ]
            }
        ],
        "Fuse": [
            {
                "patch": "February 04, 2021 Patch",
                "details": [
                    "[Knuckle Cluster] Fix -> Fixed an issue that allowed it to do damage through shields."
                ]
            },
            {
                "patch": "February 02, 2021 Patch",
                "details": [
                    "[The Motherlode] Buff -> The Motherlode: Now damages and destroys Launch Pads.",
                    "[The Motherlode] Buff -> When under a small enclosure, players will no longer be pushed out after using it.",
                    "[Double Grenades] Nerf -> Players can no longer double their grenades after looting a dead Fuse’s Death Box."
                ]
            },
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[The Motherlode] Buff -> Now damages and destroys Launch Pads.",
                    "[The Motherlode] Buff -> When under a small enclosure, players will no longer be pushed out after using it."
                ]
            }
        ],
        "Gibraltar": [
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Dome of Protection] Nerf -> Removed 15% fast healing while inside the dome shield.",
                    "[Gun Shield] Fix -> Damaging the Gun Shield now counts as damage towards Evo Shield and stats.",
                    "[Gun Shield] Fix -> Damage that exceeds the Gun Shield’s 50 HP will now bleed through to damage Gibraltar.",
                    "[Issue with hit registrations] Fix -> Corrected an issue with Gibraltar not getting hit registrations when simultaneously releasing ADS and shooting while it was up."
                ]
            }
        ],
        "Horizon": [
            {
                "patch": "March 09, 2021 Patch",
                "details": [
                    "[Black Hole] Nerf -> Increased cooldown from 2 minutes to 3 minutes.",
